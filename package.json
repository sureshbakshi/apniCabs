{
  "name": "apnicabi",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "start:user": "react-native start --port 8081",
    "start:driver": "react-native start --port 8082",
    "test": "jest",
    "adb:reverse:user": "adb devices | tail -n +2 | awk '{print $1}' | xargs -I {} sh -c 'adb -s {} reverse tcp:8081 tcp:8081; adb -s {} reverse tcp:8097 tcp:8097'",
    "adb:reverse:driver": "adb devices | tail -n +2 | awk '{print $1}' | xargs -I {} sh -c 'adb -s {} reverse tcp:8082 tcp:8082; adb -s {} reverse tcp:8097 tcp:8097'",
    "dev:user": "concurrently \"ENVFILE=.env.dev.user yarn start:user\" \"yarn adb:reverse:user && cd android && ENVFILE=.env.dev.user ./gradlew installUserDevDebug -PreactNativeDevServerPort=8081 -PreactNativeArchitectures=arm64-v8a\"",
    "dev:driver": "concurrently \"ENVFILE=.env.dev.driver yarn start:driver\" \"yarn adb:reverse:driver && cd android && ENVFILE=.env.dev.driver ./gradlew installDriverDevDebug -PreactNativeDevServerPort=8082 -PreactNativeArchitectures=arm64-v8a\"",
    "android:user": "cd android && ENVFILE=.env.dev.user ./gradlew installUserDevDebug -PreactNativeDevServerPort=8081 -PreactNativeArchitectures=arm64-v8a && cd ..",
    "android:driver": "cd android && ENVFILE=.env.dev.driver ./gradlew installDriverDevDebug -PreactNativeDevServerPort=8082 -PreactNativeArchitectures=arm64-v8a && cd ..",
    "prod:user": "concurrently \"ENVFILE=.env.prod.user yarn start:user\" \"yarn adb:reverse:user && cd android && ENVFILE=.env.prod.user ./gradlew installUserDevDebug -PreactNativeDevServerPort=8081 -PreactNativeArchitectures=arm64-v8a\"",
    "prod:driver": "concurrently \"ENVFILE=.env.prod.driver yarn start:driver\" \"yarn adb:reverse:driver && cd android && ENVFILE=.env.prod.driver ./gradlew installDriverDevDebug -PreactNativeDevServerPort=8082 -PreactNativeArchitectures=arm64-v8a\"",
    "prod:assemble:user": "cd android && ENVFILE=.env.prod.user ./gradlew assembleUserProdRelease && cd ..",
    "prod:assemble:driver": "cd android && ENVFILE=.env.prod.driver ./gradlew assembleDriverProdRelease && cd ..",
    "dev:assemble:user": "cd android && ENVFILE=.env.dev.user ./gradlew assembleUserDevRelease && cd ..",
    "dev:assemble:driver": "cd android && ENVFILE=.env.dev.driver ./gradlew assembleDriverDevRelease && cd ..",
    "release:user": "cd android && ENVFILE=.env.prod.user ./gradlew bundleUserProdRelease && cd ..",
    "release:driver": "cd android && ENVFILE=.env.prod.driver ./gradlew bundleDriverProdRelease && cd ..",
    "clean": "cd android && ./gradlew clean && cd ..",
    "clean:project": "react-native-clean-project",
    "bugsnag:create-build": "bugsnag-cli create-build",
    "bugsnag:upload-android-ndk": "bugsnag-cli upload android-ndk android/",
    "bugsnag:upload-android-proguard": "bugsnag-cli upload android-proguard android/",
    "bugsnag:upload-rn-android": "bugsnag-cli upload react-native-android",
    "bugsnag:upload-dsym": "bugsnag-cli upload dsym ios/",
    "bugsnag:upload-rn-ios": "bugsnag-cli upload react-native-ios",
    "bugsnag:upload": "bugsnag-cli upload android-ndk android/ && bugsnag-cli upload android-proguard android/ && bugsnag-cli upload react-native-android && bugsnag-cli upload dsym ios/ && bugsnag-cli upload react-native-ios",
    "project:clean": "react-native-clean-project",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@bugsnag/plugin-react-navigation": "8.6.0",
    "@bugsnag/react-native": "8.7",
    "@hookform/resolvers": "^3.3.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/drawer": "^6.6.14",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.9.22",
    "@reduxjs/toolkit": "^2.2.1",
    "@supersami/rn-foreground-service": "^2.2.5",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.6.8",
    "i18next": "^24.2.0",
    "lodash": "^4.17.21",
    "react": "19.1.1",
    "react-hook-form": "^7.51.5",
    "react-i18next": "^15.3.1",
    "react-native": "^0.82.0",
    "react-native-clean-project": "^4.0.3",
    "react-native-config": "^1.6.1",
    "react-native-device-info": "^14.0.4",
    "react-native-env": "^0.0.6",
    "react-native-fs": "^2.20.0",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-google-places-autocomplete": "^2.6.1",
    "react-native-html-to-pdf": "^0.12.0",
    "react-native-immediate-phone-call": "^2.0.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-maps": "1.26.20",
    "react-native-material-ripple": "^0.9.1",
    "react-native-modal": "^13.0.0",
    "react-native-notifications": "^5.2.2",
    "react-native-open-maps": "^0.4.3",
    "react-native-otp-auto-fill": "^0.1.17",
    "react-native-pager-view": "^8.0.0",
    "react-native-permissions": "^5.4.4",
    "react-native-rename": "^3.2.17",
    "react-native-safe-area-context": "^5.6.0",
    "react-native-screens": "^4.11.1",
    "react-native-select-contact": "^1.6.3",
    "react-native-select-dropdown": "^4.0.1",
    "react-native-share": "^10.2.1",
    "react-native-skeleton-placeholder": "^5.2.4",
    "react-native-sound-player": "^0.14.5",
    "react-native-splash-screen": "^3.3.0",
    "react-native-tab-view": "^4.2.2",
    "react-native-timer": "^1.3.6",
    "react-native-toast-message": "^2.2.0",
    "react-native-vector-icons": "^10.1.0",
    "react-native-webview": "^13.16.0",
    "react-redux": "^9.1.0",
    "redux-persist": "^6.0.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@bugsnag/cli": "^2.4.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "^0.82.0",
    "@react-native/eslint-config": "^0.82.0",
    "@react-native/metro-config": "^0.82.0",
    "@tsconfig/react-native": "^3.0.0",
    "@types/react": "^18.2.22",
    "@types/react-native-vector-icons": "^6.4.15",
    "@types/react-test-renderer": "^18.0.7",
    "babel-jest": "^29.7.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "jest": "^29.2.1",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.2.5",
    "react-devtools": "^6.1.5",
    "react-native-paper": "^5.12.3",
    "react-test-renderer": "19.1.1",
    "typescript": "5.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}